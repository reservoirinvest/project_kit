# --- Python / uv ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- Secrets folder: NEVER in git, fine in Google Drive (Drive is the secure channel) ---
.secrets/
.env
.env.*
!.env.example

# --- Data: large/binary, regenerable from source, not meant for git history ---
data/master/*.pkl
data/master/*.pickle
data/**/*.csv
data/**/*.parquet

# --- Raw project inputs: not source, not regenerable, not for git history ---
.raw/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.stackdump
.vscode/*
!.vscode/settings.json
.idea/

# --- Logs ---
.claude/hooks.log
*.log

# --- Zed ---
.zed/
